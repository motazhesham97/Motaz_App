# Railway service variables for the backend service.
# In Railway, set Root Directory to /motaz_app so railway.toml and the Docker
# build context match this repository layout.

runmode=production
serverid=default
logging=normal
role=monolith

# Railway provides PORT and RAILWAY_PUBLIC_DOMAIN automatically after you add a
# public domain. Override these only if you need a custom domain or target port.
# SERVERPOD_API_BIND_PORT=${PORT}
SERVERPOD_API_HOST=motazapp-production.up.railway.app
SERVERPOD_API_PORT=443
SERVERPOD_API_SCHEME=https
SERVERPOD_INSIGHTS_PORT=443
SERVERPOD_INSIGHTS_SCHEME=https
SERVERPOD_WEB_PORT=443
SERVERPOD_WEB_SCHEME=https

# Neon direct connection values. Use the direct host, not the -pooler host,
# because the container applies Serverpod migrations on deploy.
SERVERPOD_DATABASE_HOST=<your-neon-direct-host>
SERVERPOD_DATABASE_PORT=5432
SERVERPOD_DATABASE_NAME=<your-neon-database-name>
SERVERPOD_DATABASE_USER=<your-neon-user>
SERVERPOD_DATABASE_REQUIRE_SSL=true
SERVERPOD_DATABASE_PASSWORD=<your-neon-password>

# Serverpod production secrets. Use the same production/auth secrets that your
# current working server uses if you want existing users and sessions to remain valid.
SERVERPOD_SERVICE_SECRET=<production-service-secret>
SERVERPOD_EMAIL_SECRET_HASH_PEPPER=<production-email-pepper>
SERVERPOD_JWT_HMAC_SHA512_PRIVATE_KEY=<production-jwt-private-key>
SERVERPOD_JWT_REFRESH_TOKEN_HASH_PEPPER=<production-refresh-pepper>

# Cloudinary unsigned upload configuration for document photos.
CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/<cloud-name>/auto/upload
CLOUDINARY_UPLOAD_PRESET=<unsigned-upload-preset>
