# Optional Docker compose overrides.
# Copy values into .env next to docker-compose.yaml, or export them in your shell.

# For a physical Android phone, set this to the laptop/server LAN IP.
# Example from this machine right now: 10.226.182.94
MOTAZ_PUBLIC_HOST=localhost
MOTAZ_PUBLIC_SCHEME=http
MOTAZ_PUBLIC_PORT=8080
MOTAZ_INSIGHTS_PUBLIC_PORT=8081
MOTAZ_WEB_PUBLIC_PORT=8082

MOTAZ_API_PORT=8080
MOTAZ_INSIGHTS_PORT=8081
MOTAZ_WEB_PORT=8082

# The Docker backend should normally connect to Neon.
# Keep the real database password in config/passwords.yaml.
SERVERPOD_DATABASE_HOST=<your-neon-host>
SERVERPOD_DATABASE_PORT=5432
SERVERPOD_DATABASE_NAME=<your-database-name>
SERVERPOD_DATABASE_USER=<your-database-user>
SERVERPOD_DATABASE_REQUIRE_SSL=true

# Optional local PostgreSQL profile for isolated tests only:
# docker compose --profile local-db up -d postgres
MOTAZ_POSTGRES_PORT=8090
MOTAZ_POSTGRES_PASSWORD=motaz_docker_password
