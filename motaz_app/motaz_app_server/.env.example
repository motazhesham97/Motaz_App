# Serverpod/Neon environment template.
# Put the real database password in config/passwords.yaml, not in this file.
# Use the direct Neon host for Serverpod migrations, for example:
# ep-example.eu-west-2.aws.neon.tech, not ep-example-pooler.eu-west-2.aws.neon.tech.
SERVERPOD_DATABASE_HOST=<your-neon-host>
SERVERPOD_DATABASE_PORT=5432
SERVERPOD_DATABASE_NAME=<your-database-name>
SERVERPOD_DATABASE_USER=<your-database-user>
SERVERPOD_DATABASE_REQUIRE_SSL=true

SERVERPOD_API_HOST=localhost
SERVERPOD_API_PORT=443
SERVERPOD_API_SCHEME=https
SERVERPOD_INSIGHTS_HOST=localhost
SERVERPOD_INSIGHTS_PORT=443
SERVERPOD_INSIGHTS_SCHEME=https
SERVERPOD_WEB_HOST=localhost
SERVERPOD_WEB_PORT=443
SERVERPOD_WEB_SCHEME=https
SERVERPOD_REDIS_HOST=localhost
SERVERPOD_REDIS_PORT=6379

# Cloudinary unsigned upload configuration for document photos.
# Keep API Secret out of the app and repository.
CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/<cloud-name>/auto/upload
CLOUDINARY_UPLOAD_PRESET=<unsigned-upload-preset>
