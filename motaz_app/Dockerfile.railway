FROM dart:stable

WORKDIR /app

# Copy only the backend packages needed by Serverpod.
# Do NOT copy motaz_app_flutter because it requires Flutter SDK.
COPY motaz_app_client ./motaz_app_client
COPY motaz_app_server ./motaz_app_server

# Some Serverpod/Flutter monorepos use Dart workspaces.
# Railway server build must not include the Flutter workspace package.
RUN if grep -q "resolution: workspace" /app/motaz_app_server/pubspec.yaml; then \
      sed -i '/^resolution: workspace/d' /app/motaz_app_server/pubspec.yaml; \
    fi && \
    if grep -q "resolution: workspace" /app/motaz_app_client/pubspec.yaml; then \
      sed -i '/^resolution: workspace/d' /app/motaz_app_client/pubspec.yaml; \
    fi

WORKDIR /app/motaz_app_server

RUN dart pub get

EXPOSE 8080

CMD ["sh", "-c", "export SERVERPOD_API_SERVER_PORT=${PORT:-8080}; dart bin/main.dart --mode production"]