FROM dart:stable

WORKDIR /app

# Copy backend packages only.
# Do NOT copy motaz_app_flutter because it requires Flutter SDK.
COPY motaz_app_client ./motaz_app_client
COPY motaz_app_server ./motaz_app_server

# Install Serverpod CLI.
# Keep this version aligned with your Serverpod package version.
RUN dart pub global activate serverpod_cli 3.4.7

ENV PATH="/root/.pub-cache/bin:${PATH}"

# Remove Dart workspace resolution for Railway server-only build.
# The original project can keep workspace mode locally.
RUN sed -i '/^[[:space:]]*resolution:[[:space:]]*workspace[[:space:]]*$/d' /app/motaz_app_server/pubspec.yaml && \
    sed -i '/^[[:space:]]*resolution:[[:space:]]*workspace[[:space:]]*$/d' /app/motaz_app_client/pubspec.yaml

WORKDIR /app/motaz_app_server

RUN dart pub get

RUN serverpod generate

EXPOSE 8080

CMD ["sh", "-c", "export SERVERPOD_API_SERVER_PORT=${PORT:-8080}; dart bin/main.dart --mode production"]